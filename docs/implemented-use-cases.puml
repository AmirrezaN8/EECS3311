@startuml
left to right direction
actor Graduate
actor "Configured LLM" as LLM
actor Adzuna
actor "Brave Search" as Search
rectangle "Java career preparation (Swing / CLI)" {
usecase "F01 / UC01\nAdd, find or approve estimated posting" as UC1
usecase "F02 / UC02\nImport resume and extract profile" as UC2
usecase "F03 / UC03\nRemember, view, edit, delete facts" as UC3
usecase "F04 / UC04\nIdentify prioritized skill gaps" as UC4
usecase "F05 / UC05\nReview and accept extractive edits" as UC5
usecase "F06 / UC06\nResearch sourced goals and values" as UC6
usecase "F07 / UC07\nGenerate five interview questions" as UC7
usecase "F08 / UC08\nTyped mock interview and final feedback" as UC8
usecase "F09 / UC09\nBuild checklist and track progress" as UC9
usecase "F10 / UC10\nApprove a multi-step preparation plan" as UC10
}
Graduate --> UC1
Graduate --> UC2
Graduate --> UC3
Graduate --> UC4
Graduate --> UC5
Graduate --> UC6
Graduate --> UC7
Graduate --> UC8
Graduate --> UC9
Graduate --> UC10
UC1 --> Adzuna
UC1 --> LLM
UC2 --> LLM
UC3 --> LLM
UC4 --> LLM
UC5 --> LLM
UC6 --> Search
UC6 --> LLM
UC7 --> LLM
UC8 --> LLM
UC9 --> LLM
UC10 --> LLM
UC10 ..> UC4 : approved action
UC10 ..> UC5 : approved action
UC10 ..> UC6 : approved action
UC10 ..> UC7 : approved action
UC10 ..> UC9 : final action
@enduml
