@startuml
!pragma layout smetana
title Implemented use cases — Swing and independent CLI
left to right direction
skinparam backgroundColor white
skinparam defaultFontName SansSerif
skinparam defaultFontSize 14
skinparam shadowing false
actor "Graduate / User" as User
actor "Jev\nfixed-option decisions" as Jev
actor "Claude\ngeneration / reasoning" as Claude
actor Adzuna
actor "Brave Search" as Search
rectangle "Career Preparation Agent — Java / SQLite" {
  usecase "F01 / UC01\nSave pasted posting, look up excerpt\nor approve an estimate" as UC1
  usecase "F02 / UC02\nImport resume and extract profile" as UC2
  usecase "F03 / UC03\nRemember, view, edit and delete facts" as UC3
  usecase "F04 / UC04\nIdentify grouped skill gaps" as UC4
  usecase "F05 / UC05\nReview/approve bounded wording edits" as UC5
  usecase "F06 / UC06\nResearch sourced company goals/values" as UC6
  usecase "F07 / UC07\nPrepare five interview questions" as UC7
  usecase "F08 / UC08\nTyped interview, optional follow-ups\nand final/approved partial feedback" as UC8
  usecase "F09 / UC09\nBuild checklist and persist progress" as UC9
  usecase "F10 / UC10\nPlan and execute preparation steps" as UC10
}
User --> UC1
User --> UC2
User --> UC3
User --> UC4
User --> UC5
User --> UC6
User --> UC7
User --> UC8
User --> UC9
User --> UC10
UC1 --> Adzuna
UC1 --> Jev
UC1 --> Claude
UC2 --> Claude
UC3 --> Jev
UC3 --> Claude
UC4 --> Jev
UC4 --> Claude
UC5 --> Claude
UC6 --> Search
UC6 --> Jev
UC6 --> Claude
UC7 --> Claude
UC8 --> Jev
UC8 --> Claude
UC9 --> Claude
UC10 --> Jev
UC10 ..> UC1 : selected step
UC10 ..> UC2 : selected step
UC10 ..> UC4 : selected step
UC10 ..> UC5 : selected step
UC10 ..> UC6 : selected step
UC10 ..> UC7 : selected step
UC10 ..> UC9 : selected step
note bottom of UC10
  Available selected steps are optional, not mandatory includes.
  Explicit requests run directly; proposed steps need approval.
  Checklist success, done, stop, a limit or exhaustion ends the plan.
  A mock interview is started separately, with consent.
end note
@enduml
